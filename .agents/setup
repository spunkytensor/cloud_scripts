#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Matt Curfman
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

readonly RUST_VERSION="1.96.1"
readonly -a REQUIRED_PACKAGES=(
  build-essential
  ca-certificates
  curl
  git
  openssh-client
)

missing_packages=()
for package in "${REQUIRED_PACKAGES[@]}"; do
  if ! dpkg-query --show --showformat='${Status}' "${package}" 2>/dev/null | grep -Fqx 'install ok installed'; then
    missing_packages+=("${package}")
  fi
done

if (( ${#missing_packages[@]} > 0 )); then
  printf 'Installing system packages: %s\n' "${missing_packages[*]}"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
else
  printf 'System packages are already installed.\n'
fi

if [[ ! -x "${HOME}/.cargo/bin/rustup" ]]; then
  printf 'Installing rustup.\n'
  rustup_install="$(mktemp)"
  trap 'rm -f "${rustup_install}"' EXIT
  curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
    --output "${rustup_install}" https://sh.rustup.rs
  sh "${rustup_install}" -y --profile minimal --default-toolchain none
  rm -f "${rustup_install}"
  trap - EXIT
fi

"${HOME}/.cargo/bin/rustup" toolchain install "${RUST_VERSION}" \
  --profile minimal --component rustfmt,clippy
mkdir -p "${HOME}/.local/bin"
for rust_tool in cargo cargo-clippy cargo-fmt clippy-driver rustc rustdoc rustfmt rustup; do
  ln -sfn "${HOME}/.cargo/bin/${rust_tool}" "${HOME}/.local/bin/${rust_tool}"
done

printf 'Orb setup complete. Copy vps.example.toml to vps.toml only when operator credentials are available.\n'
