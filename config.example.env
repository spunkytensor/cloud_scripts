# Copy this file to config.env and edit the required values.

# DigitalOcean settings. DO_SSH_KEY may be a key ID or fingerprint from:
#   doctl compute ssh-key list
DO_SSH_KEY=""
# Local private key corresponding to DO_SSH_KEY. Use ${HOME}, not a quoted ~.
SSH_PRIVATE_KEY_FILE="${HOME}/.ssh/id_digitalocean_v2"
DO_REGION="nyc3"
DO_SIZE="s-4vcpu-8gb"
DO_IMAGE="ubuntu-24-04-x64"
DO_TAGS="codex-agent"
DROPLET_NAME="codex-agent-$(date +%Y%m%d-%H%M%S)"

# GitHub repository and job settings. REPOSITORY accepts owner/repo or a
# github.com URL. During create.sh, create a dedicated fine-grained PAT when
# prompted. You may instead point GITHUB_TOKEN_FILE at a mode-0600 file
# containing that token.
REPOSITORY="your-github-user/your-repository"
BASE_BRANCH="main"
# Leave blank to generate and persist a unique branch for each environment.
# Set an explicit value when coordinating a known branch; changing it while
# an environment exists is rejected rather than silently switching tasks.
WORK_BRANCH=""
GITHUB_TOKEN_FILE=""

# Optional Git commit identity used in the VPS checkout.
GIT_AUTHOR_NAME="Codex VPS Agent"
GIT_AUTHOR_EMAIL="codex-vps-agent@users.noreply.github.com"

# State can be overridden to control more than one Droplet independently.
VPS_STATE_FILE="${VPS_CODEX_DIR}/.state/current.env"
