# Copy this file to config.env and edit the required values.

# DigitalOcean settings. DO_SSH_KEY may be a key ID or fingerprint from:
#   doctl compute ssh-key list
DO_SSH_KEY=""
# Local private key corresponding to DO_SSH_KEY. Use ${HOME}, not a quoted ~.
SSH_PRIVATE_KEY_FILE="${HOME}/.ssh/id_digitalocean_v2"

# Region slug. Common choices include:
#   DO_REGION="nyc3"  # New York City, US
#   DO_REGION="sfo3"  # San Francisco, US
#   DO_REGION="ams3"  # Amsterdam, Netherlands
#   DO_REGION="lon1"  # London, UK
#   DO_REGION="fra1"  # Frankfurt, Germany
#   DO_REGION="tor1"  # Toronto, Canada
#   DO_REGION="sgp1"  # Singapore
#   DO_REGION="blr1"  # Bangalore, India
#   DO_REGION="syd1"  # Sydney, Australia
# Check current availability with: doctl compute region list
# Official region list:
#   https://docs.digitalocean.com/platform/regional-availability/
# doctl reference:
#   https://docs.digitalocean.com/reference/doctl/reference/compute/region/list/
DO_REGION="nyc3"

# Droplet size slug. Common Basic shared-CPU choices include:
#   DO_SIZE="s-2vcpu-4gb"   # 2 vCPU, 4 GiB RAM
#   DO_SIZE="s-4vcpu-8gb"   # 4 vCPU, 8 GiB RAM
#   DO_SIZE="s-6vcpu-16gb"  # 6 vCPU, 16 GiB RAM
#   DO_SIZE="s-8vcpu-32gb"  # 8 vCPU, 32 GiB RAM
# This workflow defaults to 4 vCPU / 8 GiB for Docker, local Supabase, the
# application, tests, and Codex. Available sizes and prices vary by region.
# Inspect current Basic, General Purpose, CPU-Optimized, Memory-Optimized, and
# Storage-Optimized choices with:
#   doctl compute size list --format Slug,Description,VCPUs,Memory,PriceHourly
# Official doctl size reference:
#   https://docs.digitalocean.com/reference/doctl/reference/compute/size/list/
# Droplet plan comparison:
#   https://docs.digitalocean.com/products/droplets/concepts/choosing-a-plan/
DO_SIZE="s-4vcpu-8gb"
DO_IMAGE="ubuntu-24-04-x64"

DO_TAGS="codex-agent"
DROPLET_NAME_PREFIX="codex-agent"

# Optional Git commit identity used in the VPS checkout.
GIT_AUTHOR_NAME="Codex VPS Agent"
GIT_AUTHOR_EMAIL="codex-vps-agent@users.noreply.github.com"

# Optional location for per-instance lifecycle state.
VPS_INSTANCE_STATE_DIR="${VPS_CODEX_DIR}/.state/instances"
